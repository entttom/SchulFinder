---
// Schriften liegen auf dem eigenen Server (kein Abruf bei Google)
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/fraunces/opsz.css';
import '../styles/global.css';
import '../styles/planer.css';
interface Props { title: string; description?: string; fab?: boolean }
const { title, description = 'Schulen in Österreich auf der Karte finden: Volksschulen, Mittelschulen, Gymnasien und mehr.', fab = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f4ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1311" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      try { var t = localStorage.getItem('schulfinder-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    {fab && (
      <a class="fab" id="fab" href={`${base}vergleich/`} aria-label="Zum Vergleich">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h6v14H4zM14 5h6v14h-6z"/></svg>
        <span class="fab-text">Vergleich</span>
        <span class="fab-count" id="fabCount" hidden></span>
      </a>
    )}
    <script>
      import '../scripts/fab.ts';
      import '../scripts/zurueck.ts';
      import '../scripts/theme.ts';
    </script>
  </body>
</html>
