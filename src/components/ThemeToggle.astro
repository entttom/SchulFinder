---
// Dreifach-Schalter: System → Hell → Dunkel. Das Skript (scripts/theme.ts) setzt Zustand und Beschriftung.
// nurSeite: wird beim Einblenden der Detailseite in der Karte nicht mit übernommen.
const { nurSeite = false } = Astro.props;
---
<button type="button" {...(nurSeite ? { 'data-nur-seite': '' } : {})} class="icon-btn theme-toggle" data-theme-toggle data-modus="auto" aria-label="Darstellung: System" title="Darstellung: System">
  <svg class="ico t-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"/></svg>
  <svg class="ico t-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ico t-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
</button>
