---
import Base from '../../layouts/Base.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base fab={false} title="Einzugsgebiete an meiner Adresse – SchulFinder" description="Prüfe, aus welchen Schulen Kinder in deiner Gegend kommen: Einzugsgebiete der Schulen an deiner Adresse.">
  <div class="vg ez" id="ez">
    <header class="vg-top ez-top">
      <a class="back" data-zurueck href={base}>← Karte</a>
      <h1>Einzugsgebiete an meiner Adresse</h1>
      <ThemeToggle />
      <p class="muted ez-intro">Zeigt, welche Schulen in deiner Gegend Kinder aufnehmen. Grundlage ist der Wohnort der Schülerinnen und Schüler.</p>
    </header>

    <section class="ez-form" aria-label="Adresse">
      <form id="ezForm" autocomplete="street-address">
        <div class="search">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="ezAdresse" type="search" placeholder="Straße, Hausnummer, Ort" aria-label="Adresse" enterkeyhint="search" autocapitalize="off" spellcheck="false" />
          <button type="button" id="ezLocate" class="icon-btn" aria-label="Meinen Standort verwenden">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7"/></svg>
          </button>
        </div>
        <div class="field">
          <span class="label" id="ezArtLabel">Schulart</span>
          <div class="chips scroll" id="ezArt" role="group" aria-labelledby="ezArtLabel"></div>
        </div>
        <button type="submit" class="btn primary" id="ezGo">Einzugsgebiete prüfen</button>
      </form>
      <p class="muted ez-privat">Die Adresse wird nur für die Ortssuche an <a href="https://nominatim.openstreetmap.org" target="_blank" rel="noopener">Nominatim (OpenStreetMap)</a> gesendet und von SchulFinder nicht gespeichert. Mit dem Standort-Knopf bleibt sie auf deinem Gerät.</p>
    </section>

    <section class="ez-ergebnis" aria-live="polite">
      <div id="ezStatus" class="ez-status" hidden></div>
      <ul id="ezListe" class="vg-rows ez-liste"></ul>
      <p id="ezHinweis" class="muted" hidden>
        Das ist kein Schulsprengel und kein Anspruch auf einen Platz. Es zeigt, aus welchen Gegenden die Kinder der Schule im aktuellen Schuljahr kommen. Die Angaben sind Anzahlen je 500-m-Zelle, Zellen mit weniger als 3 Kindern sind zusammengefasst.
        Quelle: Statistik Austria, Schulatlas.
      </p>
    </section>
  </div>
  <script>
    import '../../scripts/einzugsgebiet.ts';
  </script>
</Base>
