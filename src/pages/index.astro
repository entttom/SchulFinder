---
import Base from '../layouts/Base.astro';
---
<Base title="SchulFinder – Schulen in Österreich">
  <div class="app" id="app">
    <div id="map" role="application" aria-label="Karte der Schulen"></div>

    <div class="panel">
      <header class="top">
        <form class="search" id="searchForm" role="search" autocomplete="off">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="q" type="search" placeholder="Ort oder Schulname" aria-label="Ort oder Schulname suchen" enterkeyhint="search" autocomplete="off" autocapitalize="off" spellcheck="false" />
          <button type="button" id="locate" class="icon-btn" aria-label="Meinen Standort verwenden">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7"/></svg>
          </button>
        </form>
        <ul id="suggest" class="suggest" role="listbox" hidden></ul>
        <div class="chips" id="chips" role="group" aria-label="Filter"></div>
      </header>

      <section id="sheet" class="sheet" data-state="peek" aria-label="Ergebnisliste">
        <button type="button" class="grab" id="grab" aria-label="Liste vergrößern oder verkleinern"><span></span></button>
        <div class="sheet-head">
          <strong id="count" aria-live="polite">Lade Schulen …</strong>
          <span class="sheet-actions">
            <button type="button" id="locateSheet" class="sheet-locate" aria-label="Zu meinem Standort">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7"/></svg>
            </button>
            <a id="compareLink" class="btn small" href="#">Umgebung vergleichen</a>
          </span>
        </div>
        <ul id="list" class="list"></ul>
        <p class="credit">
          Daten: <a href="https://www.bildungskompass.gv.at" target="_blank" rel="noopener">Bildungskompass</a> und{' '}
          <a href="https://data.statistik.gv.at/web/meta.jsp?dataset=OGDEXT_SCHULSRV_1" target="_blank" rel="noopener">Statistik Austria</a>{' '}
          (<span id="schuljahr"></span>) · Karte: <a href="https://basemap.at" target="_blank" rel="noopener">basemap.at</a>
        </p>
      </section>
    </div>

    <aside id="card" class="card" hidden aria-live="polite"></aside>
  </div>
  <script>
    import '../scripts/map.ts';
  </script>
</Base>
