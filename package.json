{
  "name": "schulfinder",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "data": "node scripts/import.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "dev": "npm run copy:maplibre && astro dev",
    "dev:handy": "npm run copy:maplibre && DEV_HTTPS=1 astro dev --host",
    "build": "npm run copy:maplibre && astro build",
    "preview": "astro preview",
    "serve:handy": "npm run build && node scripts/serve-https.mjs",
    "copy:maplibre": "node scripts/copy-maplibre.mjs",
    "tdot": "node scripts/tdot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.8",
    "maplibre-gl": "^6.13.0",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "pbf": "^4.0.2"
  }
}
